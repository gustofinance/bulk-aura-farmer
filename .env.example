# Base58-encoded Ed25519 secret key for a dedicated trading account.
# NEVER commit your real .env file.
PRIVATE_KEY=

# "testnet" is the safe default. Use mainnet only after testing.
NETWORK=testnet
DRY_RUN=true
# Required only for live mainnet trading.
CONFIRM_MAINNET=

# Market to farm volume on, e.g. BTC-USD
SYMBOL=BTC-USD

# Size (in base asset units) to buy and then sell each round trip
TRADE_SIZE=0.001

# Minutes between rounds
INTERVAL_MINUTES=5

# Maker-first and exit settings
MAKER_WAIT_SECONDS=20
POLL_SECONDS=2
PROFIT_TARGET_BPS=20
STOP_LOSS_BPS=50
MAX_HOLD_MINUTES=10

# Fee assumptions used to place the profit target. Re-check BULK's live fee state.
# The scheduled local switch defaults to 2026-10-05; override these if BULK changes policy.
MAKER_FEE_BPS_BEFORE=0
MAKER_FEE_BPS_AFTER=3.5
TAKER_FEE_BPS=3.5
FEE_SWITCH_DATE=2026-10-05T00:00:00Z
